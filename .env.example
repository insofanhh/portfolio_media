DATABASE_URL="mysql://portfolio:password@127.0.0.1:3306/portfolio_media?connection_limit=5"
APP_URL="http://127.0.0.1:3000"
# Sessions use random tokens, hashed in the database; no JWT signing key required.
WORKER_SECRET="generate-a-different-random-secret-of-at-least-32-characters"
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="set-a-strong-password-before-seeding"
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".local/storage"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
# Production: STORAGE_DRIVER=blob. A private Blob store for sources/drafts,
# plus a separate public store for published derivatives.
BLOB_READ_WRITE_TOKEN=""
BLOB_PUBLIC_READ_WRITE_TOKEN=""
MAX_IMAGE_BYTES="52428800"
MAX_VIDEO_BYTES="2147483648"
MAX_STORAGE_BYTES="21474836480"
# MAX_STORAGE_BYTES counts source bytes; monitor derivatives/egress separately.
# Cloud Run Job, running the worker container with --once.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_REGION="asia-southeast1"
MEDIA_WORKER_JOB=""
GCP_SERVICE_ACCOUNT_JSON=""
